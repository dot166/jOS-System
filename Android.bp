android_app {
    name: "jOS-System",
    platform_apis: true,
    certificate: "platform",
    system_ext_specific: true,

    resource_dirs: ["res"],

    srcs: [
        "java/**/*.java",
        "java/**/*.kt",
    ],

    manifest: "AndroidManifest.xml",

    static_libs: [
        "j.Lib"
    ],

    aaptflags: ["--auto-add-overlay"],
    kotlincflags: ["-Xjvm-default=all"],

    optional_uses_libs: ["androidx.window.extensions", "androidx.window.sidecar"],
}
